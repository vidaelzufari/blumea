# Public canonical URL. Set to your verified production domain.
NEXT_PUBLIC_SITE_URL=https://blumeaconsulting.com
# Server-only. Create an API key at Resend and verify the sending domain.
RESEND_API_KEY=
# Must be an address on a Resend-verified domain.
RESEND_FROM_EMAIL=
# Private recipient for contact-form submissions. Configure in Sites hosting.
CONTACT_TO_EMAIL=
# Google Analytics 4 measurement ID, for example G-XXXXXXXXXX.
NEXT_PUBLIC_GA_MEASUREMENT_ID=
